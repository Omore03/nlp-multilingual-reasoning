# Direct Google AI Studio, Free tier project with billing disabled. Never commit real keys.
GOOGLE_API_KEY=replace_with_your_google_ai_studio_key
# Set true only after checking that the associated project is Free tier and billing is disabled.
GOOGLE_AI_STUDIO_FREE_TIER_CONFIRMED=false

# Optional legacy OpenRouter route; not used by the active pilot or as a fallback.
OPENROUTER_API_KEY=replace_with_your_openrouter_key
